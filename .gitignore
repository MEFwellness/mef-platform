# Live-run screenshots. These are captured against production as a real
# member, so they carry a real name and real health data, and they are
# evidence for one run rather than a reviewable artefact of the app.
docs/screens/live-polish/

# Bug sweep and verification screenshots. Pictures of a real member's
# home screen, her name and her readings. Never committed.
apps/consumer-web-app/scripts/.sweep/

# Live verification screenshots. Same reason as .sweep above.
apps/consumer-web-app/scripts/.verify/
# Same, wherever a run's SHOTS_DIR happens to land it.
**/.verify/

# Staff surface walk screenshots (scripts/walk-staff-surfaces.mjs). These
# are worse than the member ones, not better: a coach caseload and the
# admin user list are pictures of EVERY real member's name at once.
apps/consumer-web-app/scripts/.walk/
**/.walk/
