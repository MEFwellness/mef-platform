# Copy to .env.local and fill in with the values `supabase start` prints.
#
# IMPORTANT — these two are also required in any deployed environment
# (Vercel Project Settings → Environment Variables), and there they must be
# your HOSTED Supabase project's URL/anon key (Supabase Dashboard → Project
# Settings → API), never http://localhost:54321. A deployed server can't
# reach your machine's local Supabase container — pointing production at it
# fails every auth call with an opaque "fetch failed" (see lib/supabase/env.ts,
# which now throws a clearer error at least when the var is missing entirely).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, NEVER exposed with NEXT_PUBLIC_, NEVER used
# in a client component. Used by seed/admin scripts, and by the one
# background job in this app — app/api/cron/wearable-daily/route.ts.
SUPABASE_SERVICE_ROLE_KEY=
# Used to build email confirmation / password-reset redirect links
# (app/actions/auth.ts). In Vercel this must be your real deployed URL
# (e.g. https://your-app.vercel.app), not localhost — and that same URL
# must also be added to Supabase Dashboard → Authentication → URL
# Configuration → Redirect URLs, or the auth email links will fail even
# with everything else configured correctly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bot and spam protection on the auth screens (Cloudflare Turnstile).
# PUBLIC by design — it is embedded in the page every visitor downloads,
# which is why it carries the NEXT_PUBLIC_ prefix.
#
# Leave it blank and nothing changes: no widget renders, no script loads,
# no token is sent, and every auth flow behaves exactly as it did before
# this existed (lib/turnstile/env.ts).
#
# The matching SECRET key must NEVER be added here, to Vercel, or anywhere
# else in this repository. It is pasted into the Supabase dashboard only
# (Authentication -> Attack Protection -> Enable Captcha protection), and
# Supabase's own auth server is the only thing that ever holds it. This app
# forwards a token; Supabase alone decides whether it is genuine.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Wearables + Proactive AI Coach — verifies the daily cron request
# actually came from Vercel Cron (it sends `Authorization: Bearer
# $CRON_SECRET`), not some other caller of this route.
CRON_SECRET=

# Wearable provider credentials — server-only. Every provider is an
# UnconfiguredProvider stub (lib/wearables/providers/registry.ts) until
# its client id is set here; leaving these blank is the expected state
# for this milestone.
OURA_CLIENT_ID=
APPLE_HEALTH_CLIENT_ID=
GOOGLE_FIT_CLIENT_ID=

# MEF Conversation Coach (Milestone 7) — server-only, never exposed with
# NEXT_PUBLIC_. Both must be set for the Conversation Coach to call a real
# model; without them it automatically falls back to the deterministic
# fallback experience (lib/conversation-coach/fallback.ts) rather than
# failing. See lib/ai/providers/anthropic.ts.
ANTHROPIC_API_KEY=
# The exact model id available on your Anthropic account, e.g.
# claude-sonnet-4-5-20250929 — intentionally left blank rather than
# defaulted, since a wrong hardcoded model id would fail silently at
# request time.
ANTHROPIC_MODEL=

# Lead Capture Agent — public prospect-intake widget embedded on external
# Leadpages landing pages (app/api/lead-capture/route.ts,
# public/lead-widget.js). Reuses ANTHROPIC_API_KEY/ANTHROPIC_MODEL above
# by default (falls back to the deterministic templated copy in
# lib/lead-capture/fallback.ts if unconfigured, same as the Conversation
# Coach). Set LEAD_AGENT_ANTHROPIC_MODEL instead if you want this surface
# to use a different/cheaper model than Root.
LEAD_AGENT_ANTHROPIC_MODEL=

# Comma-separated list of exact origins (scheme+host[+port], e.g.
# https://your-page.leadpages.net) allowed to call the public
# /api/lead-capture endpoint from a browser. The app's own origin is
# always allowed automatically (see lib/lead-capture/cors.ts) — this is
# only for the external Leadpages domain(s) the widget will actually be
# embedded on. Required before going live; leaving it blank means no
# third-party domain can use the widget at all (fails safe, not open).
LEAD_WIDGET_ALLOWED_ORIGINS=

# Where a high-intent lead (pain + expressed readiness) is routed after
# email capture — the Discovery Assessment booking link (e.g. a Calendly
# URL). Placeholder used until this is set.
LEAD_DISCOVERY_CALL_URL=

# Where a softer lead is routed after email capture — the quiz or free
# guide link. Placeholder used until this is set.
LEAD_QUIZ_GUIDE_URL=

# Exercise Library media layer (Your Move Exercise API, ymove.app) —
# server-only, read exclusively by lib/your-move/apiClient.ts and the
# scripts/exercise-media/* offline build scripts. NEVER expose with a
# NEXT_PUBLIC_ prefix. Video/thumbnail URLs it returns are pre-signed and
# expire after 48 hours — see that file's own header for why nothing in
# this app ever stores one long-term.
YMOVE_API_KEY=
