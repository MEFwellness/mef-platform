# Copy to .env.local (in this same scripts/screenshots/ directory) and fill
# in only what you need to override. This file itself holds no secrets —
# see config.mjs's `credential()` for why the local-target values below are
# safe to leave unset (they fall back to the already-public dev seed
# accounts in supabase/seed/02_users.sql).
#
# Never commit scripts/screenshots/.env.local — it's covered by this repo's
# existing `.env*` gitignore rule (root .gitignore and
# apps/consumer-web-app/.gitignore both already have it).

# local (default) or live
SCREENSHOT_TARGET=local

# mobile (default) or tablet — or just use `npm run screenshots:tablet`
SCREENSHOT_VIEWPORT=mobile

LOCAL_BASE_URL=http://localhost:3000
LIVE_BASE_URL=https://app.mefwellness.com

# Required when SCREENSHOT_TARGET=live — there is NO fallback for live, on
# purpose. Must be a real test member's credentials, never a production
# member's own account. Leave unset for local (falls back to
# member.one@example.test / DevPassword123!, etc.).
MEMBER_POPULATED_EMAIL=
MEMBER_POPULATED_PASSWORD=
MEMBER_EMPTY_EMAIL=
MEMBER_EMPTY_PASSWORD=
COACH_EMAIL=
COACH_PASSWORD=
