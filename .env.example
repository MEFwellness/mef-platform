# Root-level placeholder. Real values live in each app's own .env.local,
# which is gitignored. This file documents what exists — it holds no secrets.

# --- Supabase ---
# Local dev: values `supabase start` prints. Deployed (Vercel, etc.): your
# HOSTED Supabase project's URL/anon key (Dashboard → Project Settings →
# API) — never a localhost URL, which a deployed server can't reach.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Bot and spam protection on the auth screens (Cloudflare Turnstile) ---
# Public site key, embedded in the page. Blank means fully dormant: no
# widget, no token, auth behaves exactly as before. The matching SECRET key
# belongs only in the Supabase dashboard and must never be set here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- MEF Conversation Coach (Milestone 7), consumer-web-app only ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Wearables + Proactive AI Coach, consumer-web-app only ---
CRON_SECRET=
OURA_CLIENT_ID=
APPLE_HEALTH_CLIENT_ID=
GOOGLE_FIT_CLIENT_ID=

# --- Exercise Library (ExerciseAPI.dev), consumer-web-app only ---
# Server-only — never expose with a NEXT_PUBLIC_ prefix. Read exclusively by
# lib/exercise-library/apiClient.ts and called only from
# app/api/exercises/route.ts and app/exercises/[id]/page.tsx (server-side).
EXERCISE_API_KEY=

# --- Exercise Library video layer (Your Move Exercise API, ymove.app),
# consumer-web-app only --- Server-only — never expose with a NEXT_PUBLIC_
# prefix. Read exclusively by lib/your-move/apiClient.ts and the
# scripts/exercise-media/* offline build scripts.
YMOVE_API_KEY=
